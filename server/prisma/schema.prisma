generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//usando enums para evitrar erro de syntax que possam explodir o banco

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
}

enum Cargo {
  GERENTE
  MEMBRO
}

enum StatusNotificacao {
  NAO_LIDA
  LIDA
}

enum Perfil {
  ADMIN
  GERENTE
  USUARIO
}

enum StatusUsuario {
  ATIVO
  PENDENTE
  DESATIVADO
}

enum CargoEquipe {
  ADMIN
  GERENTE
  MEMBRO
}

enum StatusUsuarioEquipe {
  ATIVO
  PENDENTE
  DESATIVADO
}

enum TipoToken {
  CONVITE_EQUIPE
  RESETAR_SENHA
}

//models

model Usuario {
  id       String  @id @default(uuid())
  nome     String
  email    String  @unique
  login    String  @unique
  senha    String
  foto_url String?
  perfil   Perfil  @default(USUARIO)
  status   StatusUsuario @default(ATIVO)

  projetosMembro      ProjetoMembro[]
  tarefasResponsaveis Tarefa[]          @relation("ResponsavelPelaTarefa")
  tarefasMembro       TarefaMembro[]
  comentarios         Comentario[]
  notificacoes        Notificacao[]
  historicos          HistoricoTarefa[]
  usuarioEquipes      UsuarioEquipe[]
  equipesDonas        Equipe[]          @relation("DonoEquipe")
  tokensAtivacao      TokenAtivacao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Equipe {
  id        String @id @default(uuid())
  nome      String
  descricao String?
  dono_id   String
  eh_pessoal Boolean @default(false)

  dono              Usuario            @relation("DonoEquipe", fields: [dono_id], references: [id], onDelete: Cascade)
  usuarios          UsuarioEquipe[]
  projetos          Projeto[]
  tokensAtivacao    TokenAtivacao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UsuarioEquipe {
  id        String @id @default(uuid())
  usuario_id String
  equipe_id  String
  cargo     CargoEquipe @default(MEMBRO)
  status    StatusUsuarioEquipe @default(ATIVO)

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  equipe  Equipe  @relation(fields: [equipe_id], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  ativado_em DateTime?

  @@unique([usuario_id, equipe_id])
}

model TokenAtivacao {
  id        String @id @default(uuid())
  usuario_id String
  equipe_id  String
  token     String @unique
  tipo      TipoToken @default(CONVITE_EQUIPE)
  utilizado Boolean @default(false)

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  equipe  Equipe  @relation(fields: [equipe_id], references: [id], onDelete: Cascade)

  criado_em DateTime @default(now())
  expira_em DateTime
  utilizado_em DateTime?
}

model Projeto {
  id           String     @id @default(uuid())
  nome         String
  descricao    String?
  data_inicio  DateTime?
  data_fim     DateTime?
  cor          String?    @default("#3B82F6")
  equipe_id    String?

  equipe  Equipe?           @relation(fields: [equipe_id], references: [id], onDelete: Cascade)
  membros ProjetoMembro[]
  colunas ColunaKanban[]
  tarefas Tarefa[]
  tags    Tag[]
  anexos  AnexoProjeto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjetoMembro {
  id_projeto String
  id_usuario String
  cargo      Cargo

  projeto Projeto @relation(fields: [id_projeto], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [id_usuario], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([id_projeto, id_usuario])
}

model AnexoProjeto {
  id         String @id @default(uuid())
  nome       String
  url        String
  tipo       String
  tamanho    Int?
  id_projeto String

  projeto Projeto @relation(fields: [id_projeto], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model ColunaKanban {
  id         String @id @default(uuid())
  nome       String
  ordem      Int
  id_projeto String

  projeto Projeto  @relation(fields: [id_projeto], references: [id], onDelete: Cascade)
  tarefas Tarefa[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tarefa {
  id          String     @id @default(uuid())
  titulo      String
  descricao   String?
  prioridade  Prioridade @default(MEDIA)
  progresso   Int        @default(0) // 0-100, calculado via subtarefas
  data_inicio DateTime?
  data_fim    DateTime?
  prazo       DateTime?
  ordem       Int        @default(0) // ordenação dentro da coluna

  id_responsavel String
  id_coluna      String?
  id_projeto     String

  responsavel Usuario       @relation("ResponsavelPelaTarefa", fields: [id_responsavel], references: [id], onDelete: Cascade)
  coluna      ColunaKanban? @relation(fields: [id_coluna], references: [id], onDelete: SetNull)
  projeto     Projeto       @relation(fields: [id_projeto], references: [id], onDelete: Cascade)

  subtarefas   Subtarefa[]
  membros      TarefaMembro[]
  tags         TarefaTag[]
  anexos       Anexo[]
  comentarios  Comentario[]
  notificacoes Notificacao[]
  historicos   HistoricoTarefa[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subtarefa {
  id        String  @id @default(uuid())
  titulo    String
  concluida Boolean @default(false)
  ordem     Int     @default(0)
  id_tarefa String

  tarefa Tarefa @relation(fields: [id_tarefa], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TarefaMembro {
  id_tarefa  String
  id_usuario String

  tarefa  Tarefa  @relation(fields: [id_tarefa], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [id_usuario], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([id_tarefa, id_usuario])
}

model Tag {
  id         String @id @default(uuid())
  nome       String
  cor        String @default("#000000") // hex color, ex: #FF5733
  id_projeto String

  projeto Projeto     @relation(fields: [id_projeto], references: [id], onDelete: Cascade)
  tarefas TarefaTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id_projeto, nome]) // garantir unicidade de nomes por projeto
}

model TarefaTag {
  id_tarefa String
  id_tag    String

  tarefa Tarefa @relation(fields: [id_tarefa], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [id_tag], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([id_tarefa, id_tag])
}

model Anexo {
  id        String @id @default(uuid())
  nome      String
  url       String
  tipo      String // ex: "image/png", "application/pdf", "video/mp4"
  id_tarefa String

  tarefa Tarefa @relation(fields: [id_tarefa], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comentario {
  id         String @id @default(uuid())
  texto      String
  id_usuario String
  id_tarefa  String

  usuario Usuario @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  tarefa  Tarefa  @relation(fields: [id_tarefa], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notificacao {
  id         String            @id @default(uuid())
  mensagem   String
  status     StatusNotificacao @default(NAO_LIDA)
  id_usuario String

  usuario Usuario @relation(fields: [id_usuario], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  tarefa    Tarefa?  @relation(fields: [tarefaId], references: [id])
  tarefaId  String?
}

model HistoricoTarefa {
  id             String  @id @default(uuid())
  campo_alterado String
  valor_antigo   String?
  valor_novo     String?
  id_usuario     String
  id_tarefa      String

  usuario Usuario @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  tarefa  Tarefa  @relation(fields: [id_tarefa], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}